<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!--
        The VPS's Default Web Site has WebDAV enabled (inherited from
        applicationHost.config), which intercepts non-GET verbs on
        extensionless paths before the aspNetCore handler runs, producing a
        bare 405 (discovered the hard way while deploying WordPuzzleApi).
        Removing both the module and handler here -- scoped to just this
        application via the <location> wrapper -- avoids that entirely.
      -->
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
      </handlers>
      <!-- dotnet publish injects the aspNetCore handler into this file
           automatically at publish time. The <aspNetCore> element below
           explicitly enables stdout logging so it survives every republish
           -- without this, each publish regenerates the default
           stdoutLogEnabled="false". -->
      <aspNetCore stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
