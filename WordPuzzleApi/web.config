<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!--
        The VPS's Default Web Site has WebDAV enabled (inherited from
        applicationHost.config). WebDAVModule intercepts non-standard verbs
        (POST included, in practice) on extensionless paths before the
        aspNetCore handler ever runs, producing a bare 405. Removing both
        the module and handler here — scoped to just this application via
        the <location> wrapper — fixes that without touching the WebDAV
        config the rest of the site may depend on.
      -->
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
      </handlers>
      <!-- dotnet publish injects the aspNetCore handler into this file
           automatically at publish time — left out here deliberately to
           avoid a duplicate "aspNetCore" handler registration. The
           <aspNetCore> element below (processPath/arguments get filled in
           by the same publish transform) explicitly enables stdout logging
           so it survives every republish — without this, each publish
           regenerates the default stdoutLogEnabled="false". -->
      <aspNetCore stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
