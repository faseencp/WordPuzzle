<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!--
        The VPS's Default Web Site has WebDAV enabled (inherited from
        applicationHost.config). WebDAVModule intercepts non-standard verbs
        (POST included, in practice) on extensionless paths before the
        aspNetCore handler ever runs, producing a bare 405. Removing both
        the module and handler here — scoped to just this application via
        the <location> wrapper — fixes that without touching the WebDAV
        config the rest of the site may depend on.
      -->
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
      </handlers>
      <!-- dotnet publish injects the aspNetCore handler/element into this
           file automatically at publish time — left out here deliberately
           to avoid a duplicate "aspNetCore" handler registration. -->
    </system.webServer>
  </location>
</configuration>
